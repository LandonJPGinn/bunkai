{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jpquizapp.local/schemas/quiz_bank.schema.json",
  "title": "jpquizapp quiz bank (single Quiz)",
  "description": "One bundled quiz file under assets/quiz_banks/. Parsed as Quiz in lib/models/quiz.dart. Cross-field rules (e.g. canonical answer derivation) are enforced at runtime by validateQuizBankContent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "subtitle",
    "description",
    "difficulty",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable quiz id. Bundled fallback assets must match the id registered in bundled_quiz_bank_paths.dart."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": ["N4", "N4-N3", "N3", "N3-N2", "N2"]
    },
    "diagnosticTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quizQuestion"
      }
    }
  },
  "$defs": {
    "quizQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "japanese",
        "promptEn",
        "japaneseEn",
        "explanation",
        "explanationEn",
        "diagnosticTags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "multipleChoice",
            "reorder",
            "textInput",
            "classification"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "japanese": {
          "type": "string",
          "minLength": 1
        },
        "promptEn": {
          "type": "string",
          "minLength": 1,
          "description": "English exam-style instructions (paired with prompt)."
        },
        "japaneseEn": {
          "type": "string",
          "minLength": 1,
          "description": "English gloss or glossed line paired with japanese."
        },
        "contextEn": {
          "type": "string",
          "minLength": 1,
          "description": "English counterpart to context; required in app validation when context is non-empty."
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/answerChoice"
          }
        },
        "correctAnswerId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Canonical accepted answers for typed input. If omitted, runtime falls back to the correct choice label."
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "explanationEn": {
          "type": "string",
          "minLength": 1,
          "description": "Brief English rationale (paired with explanation)."
        },
        "diagnosticTags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "jlptLevel": {
          "type": "string",
          "enum": ["N4", "N4-N3", "N3", "N3-N2", "N2"],
          "description": "Optional per-question JLPT band."
        },
        "difficultyScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Optional difficulty 1–5."
        },
        "grammarPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional grammar focus strings."
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional vocabulary items for this question."
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "reviewed", "needs_review"],
          "description": "Optional editorial review state for this question."
        },
        "reviewNotes": {
          "type": "string",
          "description": "Optional author notes for review or revision."
        },
        "source": {
          "type": "string",
          "description": "Optional content source reference."
        },
        "author": {
          "type": "string",
          "description": "Optional author or last editor name."
        }
      }
    },
    "answerChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "labelEn"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "labelEn": {
          "type": "string",
          "minLength": 1,
          "description": "English gloss for label (bundled banks require this)."
        },
        "explanation": {
          "type": ["string", "null"]
        },
        "explanationEn": {
          "type": "string",
          "minLength": 1,
          "description": "English rationale when explanation is present."
        }
      }
    }
  }
}
